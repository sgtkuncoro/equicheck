# Copy to .env and fill in. The server reads this file from the repo root.

# Only needed for the "Get help" explanations. Scanning works without it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for explanations. Override if the default id is retired.
GEMINI_MODEL=gemini-2.5-flash

# Second model tried once if the primary id is rejected as unknown.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# API port. The Vite dev server proxies /api here.
PORT=3001

# SSRF guard. false (default) refuses to scan loopback, link-local and RFC1918
# addresses. Set to true ONLY on a trusted machine, e.g. to scan this app with
# itself at http://localhost:5173.
ALLOW_PRIVATE_TARGETS=false

# Simultaneous scans allowed before the API returns 429.
MAX_CONCURRENT_SCANS=3
